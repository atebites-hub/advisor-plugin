{
  "name": "advisor",
  "version": "0.3.3",
  "description": "Consult an independent coding advisor at planning, recovery, and completion checkpoints.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "uv",
            "args": [
              "run",
              "--script",
              "${ZCODE_PLUGIN_ROOT}/advisor.py",
              "session-start"
            ],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "uv",
            "args": [
              "run",
              "--script",
              "${ZCODE_PLUGIN_ROOT}/advisor.py",
              "review-checkpoint",
              "PreToolUse"
            ],
            "timeoutMs": 10000
          }
        ],
        "matcher": "Write|Edit|MultiEdit|ApplyPatch|NotebookEdit"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "uv",
            "args": [
              "run",
              "--script",
              "${ZCODE_PLUGIN_ROOT}/advisor.py",
              "review-checkpoint",
              "Stop"
            ],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "uv",
            "args": [
              "run",
              "--script",
              "${ZCODE_PLUGIN_ROOT}/advisor.py",
              "review-checkpoint",
              "PostToolUse"
            ],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "uv",
            "args": [
              "run",
              "--script",
              "${ZCODE_PLUGIN_ROOT}/advisor.py",
              "review-checkpoint",
              "PostToolUseFailure"
            ],
            "timeoutMs": 10000
          }
        ]
      }
    ]
  },
  "userConfig": {
    "use_app_settings": {
      "type": "boolean",
      "title": "Use these advisor settings",
      "description": "Use the profiles below. Turn off to use the shared Advisor JSON configuration. Fallback permission and timeouts always come from the shared file.",
      "default": true
    },
    "claude_enabled": {
      "type": "boolean",
      "title": "Claude Code enabled",
      "description": "Allow the working agent to choose this advisor.",
      "default": true
    },
    "claude_model": {
      "type": "string",
      "title": "Claude Code model",
      "description": "Explicit model ID supported by your signed-in CLI account.",
      "default": "claude-opus-5-5",
      "required": true
    },
    "claude_effort": {
      "type": "string",
      "title": "Claude Code effort",
      "description": "low, medium, high, xhigh, or max; support depends on the model and account.",
      "default": "max",
      "required": true
    },
    "codex_enabled": {
      "type": "boolean",
      "title": "Codex CLI enabled",
      "description": "Allow the working agent to choose this advisor.",
      "default": true
    },
    "codex_model": {
      "type": "string",
      "title": "Codex CLI model",
      "description": "Explicit model ID supported by your signed-in CLI account.",
      "default": "gpt-6.1-sol",
      "required": true
    },
    "codex_effort": {
      "type": "string",
      "title": "Codex CLI effort",
      "description": "low, medium, high, xhigh, or max; support depends on the model and account.",
      "default": "max",
      "required": true
    }
  },
  "mcpServers": {
    "advisor": {
      "command": "uv",
      "args": [
        "run",
        "--script",
        "${ZCODE_PLUGIN_ROOT}/advisor.py",
        "serve"
      ],
      "env": {
        "ADVISOR_USE_APP_SETTINGS": "${user_config.use_app_settings}",
        "ADVISOR_CLAUDE_ENABLED": "${user_config.claude_enabled}",
        "ADVISOR_CLAUDE_MODEL": "${user_config.claude_model}",
        "ADVISOR_CLAUDE_EFFORT": "${user_config.claude_effort}",
        "ADVISOR_CODEX_ENABLED": "${user_config.codex_enabled}",
        "ADVISOR_CODEX_MODEL": "${user_config.codex_model}",
        "ADVISOR_CODEX_EFFORT": "${user_config.codex_effort}"
      }
    }
  }
}
