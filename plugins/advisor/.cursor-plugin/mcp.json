{
  "mcpServers": {
    "advisor": {
      "command": "uv",
      "args": [
        "run",
        "--script",
        "${CURSOR_PLUGIN_ROOT}/advisor.py",
        "serve"
      ],
      "env": {
        "ADVISOR_USE_APP_SETTINGS": "${ADVISOR_USE_APP_SETTINGS}",
        "ADVISOR_CLAUDE_ENABLED": "${ADVISOR_CLAUDE_ENABLED}",
        "ADVISOR_CLAUDE_MODEL": "${ADVISOR_CLAUDE_MODEL}",
        "ADVISOR_CLAUDE_EFFORT": "${ADVISOR_CLAUDE_EFFORT}",
        "ADVISOR_CODEX_ENABLED": "${ADVISOR_CODEX_ENABLED}",
        "ADVISOR_CODEX_MODEL": "${ADVISOR_CODEX_MODEL}",
        "ADVISOR_CODEX_EFFORT": "${ADVISOR_CODEX_EFFORT}",
        "ADVISOR_CURSOR_ENABLED": "${ADVISOR_CURSOR_ENABLED}",
        "ADVISOR_CURSOR_MODEL": "${ADVISOR_CURSOR_MODEL}",
        "ADVISOR_CURSOR_EFFORT": "${ADVISOR_CURSOR_EFFORT}"
      }
    }
  }
}
